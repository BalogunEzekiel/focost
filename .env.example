SECRET_KEY=long_random_string
DATABASE_URL=sqlite:///C:focost/instance/focost
FLASK_ENV=production
SESSION_COOKIE_SECURE=true
WTF_CSRF_TIME_LIMIT=3600
APP_VERSION=2.1.0
APP_ENCRYPTION_KEY=
FOCOST_TRIAL_AI_TOKEN_LIMIT=40000
FOCOST_TRIAL_AI_REQUEST_LIMIT=200

# AI providers - never commit real keys
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_NAME=openai/gpt-oss-120b

# Paystack - use TEST credentials locally and LIVE credentials only in production secrets
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_TIMEOUT_SECONDS=20
# Set these after creating monthly plans in the Paystack dashboard
PAYSTACK_PLAN_BASIC=
PAYSTACK_PLAN_PLUS=
PAYSTACK_PLAN_PRO=

# Optional outbound email
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Optional AI cost estimation (USD per 1M tokens; leave 0 if unknown)
FOCOST_AI_INPUT_COST_PER_1M_USD=0
FOCOST_AI_OUTPUT_COST_PER_1M_USD=0
FOCOST_USD_NGN_RATE=0

# Concise AI response controls
FOCOST_AI_MAX_TOKENS=250
FOCOST_AI_TEMPERATURE=0.3

# ---------------------------------------------------------
# Production security / compliance / transactional email
# ---------------------------------------------------------
APP_BASE_URL=https://focost.pythonanywhere.com
SESSION_COOKIE_SECURE=true
REMEMBER_COOKIE_SECURE=true
MAX_CONTENT_LENGTH=2097152
AUTH_EMAIL_VERIFICATION_REQUIRED=true
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=1440
AUTH_PASSWORD_RESET_TTL_MINUTES=60
AUTH_LOGIN_LIMIT=8
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_BLOCK_SECONDS=900
AUTH_PASSWORD_RESET_LIMIT=5
AUTH_PASSWORD_RESET_WINDOW_SECONDS=900
AUTH_DOCUMENT_MAX_BYTES=10485760
DOCUMENT_ARCHIVE_DIR=instance/document_archive
FOCOST_SUPPORT_EMAIL=support@focost.ai
FOCOST_PRIVACY_EMAIL=privacy@focost.ai
FOCOST_SECURITY_EMAIL=security@focost.ai
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@focost.ai
MAIL_USE_TLS=true

# Communications / mobile
FOCOST_PUSH_PROVIDER=fcm
FOCOST_PUSH_ENABLED=false

# Future scalable capabilities (disabled until provider/infrastructure is configured)
FOCOST_BANK_INTEGRATION_ENABLED=false
FOCOST_RECEIPT_SCANNING_ENABLED=false
FOCOST_AI_VOICE_ENABLED=false
FOCOST_MULTI_LANGUAGE_ENABLED=false
FOCOST_MULTI_CURRENCY_ENABLED=false
