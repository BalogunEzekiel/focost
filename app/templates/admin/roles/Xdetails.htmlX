{% extends "layouts/dashboard.html" %}

{% block title %}
Role Details
{% endblock %}

{% block content %}

<div class="container-fluid">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                {{ role.name }}
            </h2>

            <div class="text-muted">
                {{ role.slug }}
            </div>

        </div>

        <div>

            {% if has_permission("roles.update") %}
            <a
                href="{{ url_for('admin_roles.edit', role_id=role.id) }}"
                class="btn btn-primary">

                <i class="bi bi-pencil"></i>

                Edit

            </a>
            {% endif %}

            {% if has_permission("roles.permissions") %}
            <a
                href="{{ url_for('admin_roles.permissions', role_id=role.id) }}"
                class="btn btn-warning">

                <i class="bi bi-key"></i>

                Permissions

            </a>
            {% endif %}

        </div>

    </div>

    <div class="row">

        <!-- LEFT COLUMN -->

        <div class="col-lg-4">

            <div class="card shadow-sm mb-4">

<div class="card-header">

    <strong>

        Role Information

    </strong>

</div>

                <div class="card-body">

                    <div class="table-responsive">

                        <table class="table mb-0">

                            <tr>

                                <th>

                                    Name

                                </th>

                                <td>

                                    {{ role.name }}

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Slug

                                </th>

                                <td>

                                    {{ role.slug }}

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Description

                                </th>

                                <td>

                                    {{ role.description or "-" }}

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    System Role

                                </th>

                                <td>

                                    {% if role.is_system %}

                                    <span class="badge bg-success">

                                        Yes

                                    </span>

                                    {% else %}

                                    <span class="badge bg-secondary">

                                        No

                                    </span>

                                    {% endif %}

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Created

                                </th>

                                <td>

                                    {{ role.created_at.strftime("%d %b %Y") }}

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Status

                                </th>

                                <td>

                                    {% if role.is_active %}

                                    <span class="badge bg-success">

                                        Active

                                    </span>

                                    {% else %}

                                    <span class="badge bg-danger">

                                        Inactive

                                    </span>

                                    {% endif %}

                                </td>

                            </tr>

                        </table>

                    </div>

                </div>

            </div>

            <!-- Statistics -->

            <div class="card shadow-sm">

                <div class="card-header">

                    <strong>

                        Statistics

                    </strong>

                </div>

                <div class="card-body">

                    <div class="row text-center">

                        <div class="col-6">

                            <h3>

                                {{ permissions|length }}

                            </h3>

                            <small>

                                Permissions

                            </small>

                        </div>

                        <div class="col-6">

                            <h3>

                                {{ users|length }}

                            </h3>

                            <small>

                                Users

                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- RIGHT COLUMN -->

        <div class="col-lg-8">

            <!-- Permissions -->

            <div class="card shadow-sm mb-4">

                <div class="card-header d-flex justify-content-between">

                    <strong>
                        Permissions
                    </strong>

                </div>

                <div class="card-body">

                    {% if permissions %}

                    <div class="row">

                        {% for module, module_permissions in grouped_permissions.items() %}

                        <div class="card mb-4">

                            <div class="card-header bg-light">

                                <strong>
                                    {{ module|replace(".", " ")|title }}
                                </strong>

                            </div>

                            <div class="card-body">

                                {% for permission in module_permissions %}

                                <div class="form-check mb-2">

                                    <input
                                        class="form-check-input"
                                        type="checkbox"
                                        name="permissions"
                                        value="{{ permission.id }}"
                                        id="permission{{ permission.id }}"
                                        {% if permission.id in assigned_permission_ids %}
                                        checked
                                        {% endif %}
                                    >

                                    <label
                                        class="form-check-label"
                                        for="permission{{ permission.id }}"
                                    >

                                        <strong>
                                            {{ permission.name }}
                                        </strong>

                                        <br>

                                        <small class="text-muted">
                                            {{ permission.code }}
                                        </small>

                                    </label>

                                </div>

                                {% endfor %}

                            </div>

                        </div>

                        {% endfor %}

                    </div>

                    {% else %}

                    <div class="text-muted">

                        No permissions assigned.

                    </div>

                    {% endif %}

                </div>

            </div>

            <!-- Users -->

            <div class="card shadow-sm mb-4">

                <div class="card-header">

                    <strong>

                        Assigned Users

                    </strong>

                </div>

                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead>

                            <tr>

                                <th>Name</th>

                                <th>Email</th>

                                <th></th>

                            </tr>

                        </thead>

                        <tbody>

                        {% for user in users %}

                            <tr>

                                <td>

                                    {{ user.full_name }}

                                </td>

                                <td>

                                    {{ user.email }}

                                </td>

                                <td class="text-end">

                                    {% if has_permission("users.view") %}

                                    <a
                                        href="{{ url_for('admin_users.details', public_id=user.public_id) }}"
                                        class="btn btn-sm btn-outline-primary">

                                        View

                                    </a>

                                    {% endif %}

                                </td>

                            </tr>

                        {% else %}

                            <tr>

                                <td colspan="3"
                                    class="text-center text-muted">

                                    No users assigned.

                                </td>

                            </tr>

                        {% endfor %}

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- Recent Activity -->

            <div class="card shadow-sm">

                <div class="card-header">

                    <strong>

                        Recent Activity

                    </strong>

                </div>

                <div class="card-body">

                    {% if activities %}

                    <ul class="list-group list-group-flush">

                        {% for activity in activities %}

                        <li class="list-group-item">

                            <strong>

                                {{ activity.action }}

                            </strong>

                            <br>

                            <small class="text-muted">

                                {{ activity.description }}

                            </small>

                            <br>

                            <small class="text-secondary">

                                {{ activity.created_at.strftime("%d %b %Y %I:%M %p") }}

                            </small>

                        </li>

                        {% endfor %}

                    </ul>

                    {% else %}

                    <div class="text-muted">

                        No activity recorded.

                    </div>

                    {% endif %}

                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}